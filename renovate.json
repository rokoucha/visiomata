{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        "helpers:pinGitHubActionDigests",
        "customManagers:githubActionsVersions"
    ],
    "automerge": true,
    "automergeType": "branch",
    "lockFileMaintenance": {
        "enabled": true
    },
    "customManagers": [
        {
            "customType": "regex",
            "description": "Track the otelcol-contrib default in setup-otel-collector",
            "fileMatch": [
                "^\\.github/actions/setup-otel-collector/action\\.yml$"
            ],
            "matchStrings": [
                "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*default:\\s*['\"](?<currentValue>[^'\"]+)['\"]"
            ],
            "versioningTemplate": "semver"
        }
    ],
    "packageRules": [
        {
            "description": "Cargo lockfile maintenance requires the workspace member generated by Gradle's prepareMpeg2ToH264 task.",
            "matchManagers": [
                "cargo"
            ],
            "lockFileMaintenance": {
                "enabled": false
            }
        }
    ]
}
