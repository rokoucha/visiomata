{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        "helpers:pinGitHubActionDigests",
        "customManagers:githubActionsVersions"
    ],
    "lockFileMaintenance": {
        "enabled": true
    },
    "packageRules": [
        {
            "description": "Cargo lockfile maintenance requires the workspace member generated by Gradle's prepareMpeg2ToH264 task.",
            "matchManagers": ["cargo"],
            "lockFileMaintenance": {
                "enabled": false
            }
        }
    ]
}
